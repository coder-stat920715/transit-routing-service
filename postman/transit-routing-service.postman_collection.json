{
  "info": {
    "name": "Transit Routing Service (RAPTOR)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Functional tests for transit-routing-service. Start the app first (./mvnw spring-boot:run). Override baseUrl if not on localhost:8080."
  },
