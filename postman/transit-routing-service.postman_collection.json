  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "1.1 Benchmark: Gowlidoddy to RGIA (12:00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Response time < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test(\"Totals match benchmark\", () => {",
                  "  pm.expect(r.totalDurationMinutes).to.eql(131);",
                  "  pm.expect(r.totalTransfers).to.eql(2);",
                  "  pm.expect(r.departureTime).to.eql(\"2026-10-31T12:00:00\");",
                  "  pm.expect(r.arrivalTime).to.eql(\"2026-10-31T14:11:00\");",
                  "});",
                  "pm.test(\"Six legs: WALK, TRANSIT, TRANSIT, WALK, TRANSIT, WALK\", () => {",
                  "  pm.expect(r.legs.map(l => l.legType)).to.eql([\"WALK\",\"TRANSIT\",\"TRANSIT\",\"WALK\",\"TRANSIT\",\"WALK\"]);",
                  "});",
                  "pm.test(\"Leg 1: walk 600 m / 9 min to Heritage Fresh\", () => {",
                  "  const l = r.legs[0];",
                  "  pm.expect(l.fromName).to.eql(\"Zolo Lakeview PG\"); pm.expect(l.toName).to.eql(\"Heritage Fresh\");",
                  "  pm.expect(l.distanceMeters).to.be.within(590, 610); pm.expect(l.durationMinutes).to.eql(9);",
                  "  pm.expect(l.startTime).to.eql(\"12:00\"); pm.expect(l.endTime).to.eql(\"12:09\");",
                  "});",
                  "pm.test(\"Leg 2: 116N/220K, 2 intermediate stops, 6 min\", () => {",
                  "  const l = r.legs[1];",
                  "  pm.expect(l.routeShortName).to.eql(\"116N/220K\"); pm.expect(l.headsign).to.eql(\"Koti Medical College\");",
                  "  pm.expect(l.fromStopName).to.eql(\"Heritage Fresh\"); pm.expect(l.toStopName).to.eql(\"Nanakramguda\");",
                  "  pm.expect(l.intermediateStopsCount).to.eql(2); pm.expect(l.durationMinutes).to.eql(6);",
                  "  pm.expect(l.startTime).to.eql(\"12:10\"); pm.expect(l.endTime).to.eql(\"12:16\");",
                  "});",
                  "pm.test(\"Leg 3: 195KG, 4 intermediate stops, 13 min\", () => {",
                  "  const l = r.legs[2];",
                  "  pm.expect(l.routeShortName).to.eql(\"195KG\"); pm.expect(l.headsign).to.eql(\"JNTU\");",
                  "  pm.expect(l.fromStopName).to.eql(\"Nanakramguda\"); pm.expect(l.toStopName).to.eql(\"Gachibowli X Road\");",
                  "  pm.expect(l.intermediateStopsCount).to.eql(4); pm.expect(l.durationMinutes).to.eql(13);",
                  "});",
                  "pm.test(\"Leg 4: transfer walk ~80 m / 2 min\", () => {",
                  "  const l = r.legs[3];",
                  "  pm.expect(l.fromName).to.eql(\"Gachibowli X Road\"); pm.expect(l.toName).to.eql(\"Gachibowli\");",
                  "  pm.expect(l.distanceMeters).to.be.within(75, 85); pm.expect(l.durationMinutes).to.eql(2);",
                  "});",
                  "pm.test(\"Leg 5: AJ airport express, 3 intermediate stops, 79 min\", () => {",
                  "  const l = r.legs[4];",
                  "  pm.expect(l.routeShortName).to.eql(\"AJ\"); pm.expect(l.headsign).to.eql(\"Pushpak Airport Express\");",
                  "  pm.expect(l.toStopName).to.eql(\"Rajiv Gandhi International Airport (RGIA)\");",
                  "  pm.expect(l.intermediateStopsCount).to.eql(3); pm.expect(l.durationMinutes).to.eql(79);",
                  "});",
                  "pm.test(\"Leg 6: walk ~950 m / 14 min to Domestic Departures Terminal\", () => {",
                  "  const l = r.legs[5];",
                  "  pm.expect(l.toName).to.eql(\"Domestic Departures Terminal\");",
                  "  pm.expect(l.distanceMeters).to.be.within(940, 960); pm.expect(l.durationMinutes).to.eql(14);",
                  "  pm.expect(l.endTime).to.eql(\"14:11\");",
                  "});",
                  "pm.test(\"Legs are chronologically consistent\", () => {",
                  "  for (let i = 1; i < r.legs.length; i++) pm.expect(r.legs[i].startTime >= r.legs[i-1].endTime).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
